//@version=5
// NOTE: //@version=5 MUST be the first line of the file. It was below this
// comment block and Pine rejected the whole script at line 1 with
// 'end of line without line continuation'.
// myTrading HH/HL/LH/LL - the structure the order engine actually reads.
//
// The Orders tab's HH/HL/LH/LL triggers are evaluated against hhll.py, not
// against whatever indicator is on the chart. The two kept disagreeing, so
// this is hhll.py in Pine.
//
// THE USUAL CAUSE OF DISAGREEMENT IS THE PERIOD. hhll.py runs prd = 2.
// LonesomeTheBlue's original (which hhll.py is a port of) defaults to 10.
// A period-10 chart sees different swings. Change nothing else, change that.
//
// Faithful to hhll.py in all four stages:
//   1. symmetric window pivots, TIES ALLOWED (>= / <=, like Pine's own)
//   2. confirmed prd bars AFTER the pivot bar, never on the bar itself
//   3. zigzag alternation - consecutive same-kind pivots collapse to the
//      more extreme one rather than both surviving
//   4. labels vs the previous pivot OF THE SAME KIND
//      high -> HH if above the last high, else LH
//      low  -> HL if above the last low,  else LL
//
// Regime is close-based, never wicks.
//
// WHAT THIS CANNOT SHOW YOU: the engine will not fire on a pivot confirmed
// BEFORE the row was typed - "the next HL" has to mean new since you asked.
// The chart cannot know your row's date, so a label here is necessary but
// not sufficient. Compare the Dashboard STRUCTURE row's Confirmed date.
//
// Every statement is on ONE line on purpose: Pine's line-continuation rule
// inside a multi-line call is what rejected the first version of this file.

indicator("myTrading HH/HL/LH/LL", overlay = true, max_labels_count = 500, max_lines_count = 500)

prd = input.int(2, "ZigZag Period - hhll.py uses 2, TradingView's default is 10", minval = 1)
showSR = input.bool(true, "Show support / resistance levels")
showRgm = input.bool(true, "Colour bars by regime")

// 1. Symmetric window pivots. ta.pivothigh uses a strict >, so a tie loses
//    the pivot; hhll.py uses >=. ta.highest over 2*prd+1 bars is centred on
//    bar [prd] and compares with >=, which is exactly the rule we want.
win = prd * 2 + 1
isPH = bar_index >= win and high[prd] >= ta.highest(high, win)
isPL = bar_index >= win and low[prd] <= ta.lowest(low, win)

// 2 & 3. Alternation. The running pivot on each side extends when a more
//        extreme same-kind pivot appears, instead of adding a second one.
var float lastH = na
var float lastL = na
var int lastHBar = na
var int lastLBar = na
var string side = na
var float prevH = na
var float prevL = na
var label curLab = na

pivBar = bar_index - prd

labelFor(bool isHigh, float price) =>
    isHigh ? (na(prevH) or price > prevH ? "HH" : "LH") : (na(prevL) or price > prevL ? "HL" : "LL")

draw(bool isHigh, float price, int b) =>
    txt = labelFor(isHigh, price)
    col = txt == "HH" or txt == "HL" ? color.green : color.red
    sty = isHigh ? label.style_label_down : label.style_label_up
    label.new(b, price, txt, color = col, textcolor = color.white, size = size.small, style = sty)

if isPH and not isPL
    if side == "H"
        if high[prd] >= lastH
            label.delete(curLab)
            lastH := high[prd]
            lastHBar := pivBar
            curLab := draw(true, lastH, lastHBar)
    else
        if side == "L"
            prevL := lastL
        lastH := high[prd]
        lastHBar := pivBar
        side := "H"
        curLab := draw(true, lastH, lastHBar)
        if showSR
            line.new(lastHBar, lastH, bar_index, lastH, color = color.new(color.red, 55))

if isPL and not isPH
    if side == "L"
        if low[prd] <= lastL
            label.delete(curLab)
            lastL := low[prd]
            lastLBar := pivBar
            curLab := draw(false, lastL, lastLBar)
    else
        if side == "H"
            prevH := lastH
        lastL := low[prd]
        lastLBar := pivBar
        side := "L"
        curLab := draw(false, lastL, lastLBar)
        if showSR
            line.new(lastLBar, lastL, bar_index, lastL, color = color.new(color.green, 55))

// 4. Close-based regime. Never wicks.
var string regime = "NONE"
if not na(lastH) and close > lastH
    regime := "BULL"
if not na(lastL) and close < lastL
    regime := "BEAR"

bcol = regime == "BULL" ? color.new(color.teal, 60) : regime == "BEAR" ? color.new(color.maroon, 60) : na
barcolor(showRgm ? bcol : na)

// Read-out, to compare against the Dashboard STRUCTURE row.
var table tb = table.new(position.top_right, 2, 3, border_width = 1)
curLabel = na(side) ? "-" : side == "H" ? labelFor(true, lastH) : labelFor(false, lastL)
curPrice = na(side) ? na : side == "H" ? lastH : lastL

if barstate.islast
    table.cell(tb, 0, 0, "Last_Label", text_color = color.white, bgcolor = color.gray)
    table.cell(tb, 1, 0, curLabel, text_color = color.white, bgcolor = color.gray)
    table.cell(tb, 0, 1, "At", text_color = color.white, bgcolor = color.gray)
    table.cell(tb, 1, 1, str.tostring(curPrice, format.mintick), text_color = color.white, bgcolor = color.gray)
    table.cell(tb, 0, 2, "Regime", text_color = color.white, bgcolor = color.gray)
    table.cell(tb, 1, 2, regime, text_color = color.white, bgcolor = color.gray)
